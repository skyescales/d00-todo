# --- Database ---
# Postgres connection string. Works with Vercel Postgres, Supabase, Neon, Railway, etc.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --- App password gate (single user, no accounts) ---
APP_PASSWORD="change-me"
# Any long random string, used to sign the login session cookie.
AUTH_SECRET="replace-with-a-long-random-string"

# --- Cron protection ---
# Vercel Cron sends this as a Bearer token (Authorization header) automatically
# when set as CRON_SECRET on the project. Any manual call must match it too.
CRON_SECRET="replace-with-a-long-random-string"

# --- Automated lead sourcing (required for the daily job to find leads) ---
# Anthropic API key (console.anthropic.com -> API Keys). The cron job uses
# this to have Claude actually research the web (search + read gym
# websites/socials/Google Business Profiles) for qualifying leads.
ANTHROPIC_API_KEY=""
# Optional: override the model used for sourcing (defaults to claude-opus-5).
# claude-sonnet-5 is a cheaper alternative - see README for cost comparison.
SOURCING_MODEL=""

# --- Daily email summary (optional) ---
# Resend.com API key. Leave blank to skip emailing and rely on in-app "New" leads only.
RESEND_API_KEY=""
EMAIL_FROM="Gym Lead Tracker <leads@yourdomain.com>"
EMAIL_TO="you@example.com"
